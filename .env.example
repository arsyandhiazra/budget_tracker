# ─────────────────────────────────────────────────────────────────────────────
# PENGATURAN BUDGET TRACKER
# Salin file ini, beri nama ".env" (tanpa .example), lalu isi yang kamu perlukan.
# Semua baris boleh dibiarkan kosong: aplikasi tetap jalan dalam "mode percobaan".
# Setelah mengubah file .env, matikan server (Ctrl+C) lalu jalankan lagi "npm start".
# JANGAN bagikan file .env ke siapa pun dan jangan unggah ke GitHub.
# ─────────────────────────────────────────────────────────────────────────────

# Alamat & port aplikasi
PORT=3000
# Alamat lengkap aplikasi kalau sudah online, contoh: https://budget.namamu.com
APP_URL=

# Isi "production" kalau aplikasi sudah dipakai orang lain / ditaruh online.
# Di mode ini kode verifikasi TIDAK lagi ditampilkan di layar, jadi SMTP wajib diisi.
NODE_ENV=

# ── EMAIL (untuk kode verifikasi & lupa kata sandi) ─────────────────────────
# Kosong = mode percobaan: kode muncul di layar dan di terminal.
# Contoh pakai Gmail:
#   1. Aktifkan "Verifikasi 2 Langkah" di akun Google kamu.
#   2. Buat "Sandi Aplikasi" (App Password) di pengaturan keamanan akun Google.
#   3. Isi seperti di bawah (SMTP_PASS = sandi aplikasi 16 huruf, bukan kata sandi Gmail).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=emailkamu@gmail.com
# SMTP_PASS=abcdefghijklmnop
# SMTP_FROM=Budget Tracker <emailkamu@gmail.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── CHATBOT AI ──────────────────────────────────────────────────────────────
# Kosong = "mode dasar": chatbot tetap bisa menjawab pertanyaan umum dari datamu.
# Untuk jawaban yang lebih luwes, pilih SATU penyedia lalu isi kuncinya (API key).
#
#   AI_PROVIDER=anthropic   → Claude        (kunci dari Claude Console milik Anthropic)
#   AI_PROVIDER=openai      → ChatGPT       (kunci dari platform.openai.com)
#   AI_PROVIDER=gemini      → Google Gemini (kunci dari aistudio.google.com)
#   AI_PROVIDER=groq        → Groq          (wajib isi AI_MODEL)
#   AI_PROVIDER=openrouter  → OpenRouter    (wajib isi AI_MODEL)
#   AI_PROVIDER=custom      → layanan lain yang formatnya sama dengan OpenAI
#                             (wajib isi AI_MODEL dan AI_BASE_URL)
#
# AI_MODEL boleh dikosongkan untuk anthropic / openai / gemini (dipakai model hemat
# bawaan). Nama model sering berganti; kalau chatbot bilang modelnya tidak dikenal,
# lihat daftar model terbaru di situs penyedianya lalu tulis namanya di AI_MODEL.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# ── LAIN-LAIN (biasanya tidak perlu diubah) ─────────────────────────────────
# Lokasi file database. Bawaan: data/budget-tracker.db
DB_PATH=
# Zona waktu untuk menentukan "hari ini" di server.
APP_TIMEZONE=Asia/Jakarta
# Berapa hari pengguna tetap masuk sebelum harus login ulang.
SESSION_DAYS=30
# Di production, server dianggap berada di belakang proxy HTTPS milik hosting.
# Isi 0 hanya kalau server diakses langsung tanpa proxy.
TRUST_PROXY=
